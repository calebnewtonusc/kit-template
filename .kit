# This file marks a directory as a kit, so an agent can find it without being told.
# Chewbacca's session hook scans for these and routes work to an existing kit
# instead of rebuilding one or answering turn by turn.
#
# FILL THIS IN. Until you do, status stays "template" and this directory is
# deliberately excluded from routing, so a half-built kit never catches live work.
#
# use-when is the important line. It gets matched against what somebody actually
# types, so write it in their words. "a professor ignoring my accommodation letter"
# routes correctly. "post-approval implementation failures" does not.

name: {{NAME}}-kit
domain: {{ONE LINE: WHAT THIS COVERS}}
use-when: {{CONCRETE PHRASES SOMEBODY WOULD ACTUALLY SAY, COMMA SEPARATED}}
status: template
